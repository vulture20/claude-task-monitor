<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <Version>1.0.0</Version>
    <Authors>Thorsten Schröpel</Authors>
    <Company>Thorsten Schröpel</Company>
    <Product>Claude Task Monitor</Product>
    <Description>Stay-on-top-Fenster mit den von Claude gestarteten Prozessen, ihrer CPU-Last und der Zuordnung zu Projekt und Thread.</Description>
    <Copyright>Copyright © 2026 Thorsten Schröpel</Copyright>
    <ApplicationIcon>..\..\assets\branding\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Icon der exe (ApplicationIcon) und als WPF-Ressource für Fenster und Taskleiste -->
  <ItemGroup>
    <Resource Include="..\..\assets\branding\app.ico" Link="app.ico" />
  </ItemGroup>

  <!-- Auslieferung als einzelne exe (Aufruf siehe README). Framework-abhängig braucht sie die
       .NET 10 Desktop Runtime; als self-contained ist die Runtime enthalten. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
