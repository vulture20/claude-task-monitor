<Application x:Class="ClaudeTaskMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Farben (dunkles, neutrales Design) -->
        <SolidColorBrush x:Key="WindowBackground" Color="#FF1B1D21" />
        <SolidColorBrush x:Key="CardBackground" Color="#FF24272C" />
        <SolidColorBrush x:Key="CardBorder" Color="#FF30343A" />
        <SolidColorBrush x:Key="HoverBackground" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFE6E8EB" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FF9AA0A8" />
        <SolidColorBrush x:Key="TextMuted" Color="#FF6C727B" />
        <SolidColorBrush x:Key="Accent" Color="#FFD97757" />
        <SolidColorBrush x:Key="BarTrack" Color="#FF30343A" />
        <SolidColorBrush x:Key="StatusBusy" Color="#FF4CC38A" />
        <SolidColorBrush x:Key="StatusWaiting" Color="#FFE5A54B" />
        <SolidColorBrush x:Key="StatusIdle" Color="#FF8A8F98" />
        <SolidColorBrush x:Key="StatusUnknown" Color="#FF5C626B" />

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Kopfzeile einer Sitzung: flacher Umschalter ohne Standard-Chrome -->
        <Style x:Key="GroupHeaderToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" Padding="8,6,10,6" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Schmaler CPU-Balken -->
        <Style x:Key="CpuBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="2" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{StaticResource BarTrack}" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
